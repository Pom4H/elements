{
  "name": "@pom4h/elements-core",
  "version": "0.1.0",
  "description": "Runtime and registry primitives for composable, stateful SVG elements.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Pom4H/elements#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pom4H/elements.git",
    "directory": "packages/core"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./routing": {
      "types": "./dist/routing/index.d.ts",
      "default": "./dist/routing/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./scene": {
      "types": "./dist/scene/index.d.ts",
      "default": "./dist/scene/index.js"
    },
    "./editing": {
      "types": "./dist/editing/index.d.ts",
      "default": "./dist/editing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json --force",
    "typecheck": "tsc -b --pretty false",
    "test": "bun test"
  }
}
