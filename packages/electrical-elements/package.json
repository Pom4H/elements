{
  "name": "@pom4h/electrical-elements",
  "version": "0.1.0",
  "description": "Electrical equipment elements built on @pom4h/elements-core.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Pom4H/elements#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pom4H/elements.git",
    "directory": "packages/electrical-elements"
  },
  "sideEffects": ["./dist/register.js"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json --force",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@pom4h/elements-core": "^0.1.0"
  }
}
